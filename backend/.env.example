
# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# META DEVELOPER APP CONFIGURATION
# ==========================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Must match the Redirect URI configured in Meta Developer Dashboard
META_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/instagram/callback

# Example: v26.0
META_API_VERSION=v26.0

# ==========================================
# SESSION & SECURITY
# ==========================================
# Generate a strong random secret for your application
SESSION_SECRET=replace_with_a_long_random_secret

# Must match the Verify Token configured in Meta Webhooks
WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# ==========================================
# GOOGLE GEMINI AI CONFIGURATION
# ==========================================
GEMINI_API_KEY=your_google_ai_studio_api_key

# Replace with the Gemini model name that worked in your test
GEMINI_MODEL=your_working_gemini_model
